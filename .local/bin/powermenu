#!/bin/sh

power_off=' Power Off'
restart=' Restart'
lock=' Lock'
theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/power.rasi"

chosen=$(printf '%s\n' "$lock" "$power_off" "$restart" |
    rofi -dmenu -i -p Power -theme "$theme") || exit 0

case "$chosen" in
    "$lock") dm-tool lock ;;
    "$power_off") systemctl poweroff ;;
    "$restart") systemctl reboot ;;
    *) exit 0 ;;
esac
